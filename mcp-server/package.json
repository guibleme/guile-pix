{
  "name": "dogsprite-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for programmatic pixel art generation in DogSprite",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:core && tsc",
    "build:core": "npm --prefix ../packages/sprite-core run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@guile-pix/sprite-core": "file:../packages/sprite-core",
    "@modelcontextprotocol/sdk": "1.28.0",
    "gifenc": "^1.0.3",
    "pngjs": "7.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.0"
  }
}
